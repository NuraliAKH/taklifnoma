generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int     @id(map: "PK_a3ffb1c0c8416b9fc6f907b7433") @default(autoincrement())
  email         String  @unique(map: "UQ_97672ac88f789774dd47f7c8be3") @db.VarChar(150)
  password_hash String  @db.VarChar(255)
  role          String  @default("user") @db.VarChar(50)
  orders        Order[]

  @@map("users")
}

model Template {
  id             Int      @id(map: "PK_515948649ce0bbbe391de702ae5") @default(autoincrement())
  type           String   @db.VarChar(50)
  category       String   @db.VarChar(100)
  media_url      String   @db.VarChar(255)
  text_config    Json
  price          Decimal  @default(0) @db.Decimal(10, 2)
  discount_price Decimal? @db.Decimal(10, 2)
  orders         Order[]

  @@map("templates")
}

model Order {
  id              String   @id(map: "PK_710e2d4957aa5878dfe94e4ac2f") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_data       Json
  status          String   @default("pending") @db.VarChar(50)
  final_asset_url String?  @db.VarChar(255)
  total_price     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  templateId      Int?     @map("templateId")
  userId          Int?     @map("userId")

  template     Template?            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@map("orders")
}

model PaymentTransaction {
  id                Int      @id @default(autoincrement())
  clickTransId      BigInt   @unique @map("click_trans_id")
  serviceId         Int      @map("service_id")
  clickPaydocId     BigInt?  @map("click_paydoc_id")
  merchantTransId   String   @map("merchant_trans_id") @db.Uuid
  merchantPrepareId Int      @map("merchant_prepare_id")
  amount            Decimal  @db.Decimal(10, 2)
  action            Int
  error             Int      @default(0)
  errorNote         String?  @map("error_note") @db.VarChar(255)
  status            String   @default("prepared") @db.VarChar(50)
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamp(6)

  order Order @relation(fields: [merchantTransId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}
